<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Accès réseau : l’application est cliente de l’API https://riftarium.re. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- La permission CAMERA et la fonctionnalité « camera.any » sont déjà
         déclarées par le plugin camera_android_camerax : elles ne sont pas
         répétées ici. On ajoute seulement le capteur arrière en NON requis,
         pour que le scanner n’exclue pas du Play Store les appareils qui en
         sont dépourvus (l’écran /scan affiche alors « Aucune caméra »). -->
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <!-- Le plugin camera déclare camera.any sans required : on le rend optionnel
         pour ne pas exclure les appareils sans caméra (le scan est facultatif). -->
    <uses-feature android:name="android.hardware.camera.any" android:required="false" tools:replace="android:required" />
    <!-- allowBackup="false" : le jeton de session vit dans le Keystore, qu'une
         sauvegarde Android ne peut pas restaurer sur un autre appareil ; une
         restauration rendrait la session illisible plutôt qu'absente. Le reste
         des données locales vient de l'API et se retélécharge. -->
    <application
        android:label="Riftarium"
        android:name="${applicationName}"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <!-- Liens du site ouverts dans l’application (sans autoVerify : la
                 vérification App Links exige assetlinks.json + empreinte de la clé
                 de signature, à faire à la publication — voir WORKFLOW.md). -->
            <meta-data android:name="flutter_deeplinking_enabled" android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="riftarium.re" android:pathPrefix="/cartes" />
                <data android:scheme="https" android:host="riftarium.re" android:pathPrefix="/decks" />
                <!-- Salon de partie suivie : même chemin que le site. -->
                <data android:scheme="https" android:host="riftarium.re" android:pathPrefix="/salon" />
                <!-- Profil public : le site le publie sous /u/<pseudo>, chemin
                     que le routeur mobile sert en plus de /joueur/<pseudo>. -->
                <data android:scheme="https" android:host="riftarium.re" android:pathPrefix="/u/" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
