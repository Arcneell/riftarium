# Copier vers .env et remplir avant `docker compose up`.
# Jamais de valeurs d'exemple en production.

# 24 caractères minimum (l'API refuse de démarrer en prod sinon).
JWT_SECRET=
DB_PASSWORD=
# 16 caractères minimum (l'API refuse de démarrer en prod sinon).
ADMIN_TOKEN=
# Comptes administrateurs de la page d'admin : e-mails séparés par des virgules
# (insensible à la casse). Source de vérité unique : au démarrage, l'API accorde
# les droits aux comptes listés et les retire aux autres. Vide = aucun admin.
ADMIN_EMAILS=
REDIS_PASSWORD=
# Sel des empreintes anonymes (visiteurs uniques, vues de decks). Facultatif :
# vide = clé dérivée de JWT_SECRET. Le renseigner découple les deux usages ; le
# changer remet à zéro la déduplication (une vue de plus par visiteur anonyme).
ANALYTICS_SALT=
# Cookies marqués Secure (1 en prod derrière BunkerWeb/TLS).
# compose.dev.yaml le force à 0 en dev, inutile d'y toucher ici.
COOKIE_SECURE=1
# Bind local uniquement (BunkerWeb sur le réseau Docker, pas d'exposition publique).
PORT=8888
# Prix des cartes (TCGplayer via TCGCSV + taux BCE), rafraîchis automatiquement ~1×/jour ; 0 pour désactiver.
#PRICES_AUTOREFRESH=1

# --- E-mails transactionnels (SMTP OVH) ---
# Laisser SMTP_HOST vide = mode console : les e-mails sont loggés au lieu d'être envoyés.
SMTP_HOST=ssl0.ovh.net
SMTP_PORT=465
# Chez OVH, l'identifiant est l'adresse complète.
SMTP_USER=contact@riftarium.re
SMTP_PASSWORD=
#MAIL_FROM=Riftarium <no-reply@riftarium.re>
# Base des liens dans les e-mails (vide = https://riftarium.re en prod, http://localhost:8888 sinon).
#PUBLIC_BASE_URL=https://riftarium.re

# --- Développement uniquement (compose.dev.yaml) ---
# Port hôte de l'API en dev (uvicorn --reload), 8889 par défaut.
#API_PORT=8889
