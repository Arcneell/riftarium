# Réglages BunkerWeb (service / UI) pour proxifier Riftarium.
# Le backend est le conteneur web : http://riftarium-web:8080
# (même réseau Docker que BunkerWeb ; ne pas exposer l'API).
#
# CSP : soit KEEP_UPSTREAM_HEADERS conserve celle de nginx (recommandé),
# soit coller CONTENT_SECURITY_POLICY ci-dessous. Deux CSP distinctes cassent
# les visuels Riot.

USE_REVERSE_PROXY=yes
REVERSE_PROXY_HOST=http://riftarium-web:8080
REVERSE_PROXY_URL=/
REVERSE_PROXY_INTERCEPT_ERRORS=no
# Défaut BunkerWeb = GET|POST|HEAD seulement → PATCH/PUT/DELETE = 405 HTML
# (« Erreur inattendue » côté front). L'API utilise ces trois méthodes
# (profil, collection, decks). Sans guillemets autour de la valeur.
ALLOWED_METHODS=GET|POST|HEAD|OPTIONS|PUT|PATCH|DELETE

KEEP_UPSTREAM_HEADERS=Content-Security-Policy Permissions-Policy X-Frame-Options Referrer-Policy X-Robots-Tag
CONTENT_SECURITY_POLICY=default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; object-src 'none'; img-src 'self' data: https://cmsassets.rgpub.io https://assetcdn.rgpub.io; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'
X_FRAME_OPTIONS=SAMEORIGIN
X_CONTENT_TYPE_OPTIONS=nosniff
REFERRER_POLICY=strict-origin-when-cross-origin
STRICT_TRANSPORT_SECURITY=max-age=31536000; includeSubDomains
COOKIE_AUTO_SECURE_FLAG=yes
